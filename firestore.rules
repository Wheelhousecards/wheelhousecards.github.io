rules_version = '2';

// Wheelhouse Consignment security rules
// - Staff: anyone whose email has a document in /staff/{email}. Staff can read and write everything.
// - Customers: signed in by email link. They can read only documents stamped with their own email
//   (custEmail on listings, batches and photos; email on their customer record). They can't write anything, except their asking price on a card that is Awaiting price.
// - Staff-only data (batch notes, counters, staff list) is unreadable to customers.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(myEmail()));
    }
    function ownsDoc() {
      return signedIn() && resource.data.custEmail == myEmail();
    }

    match /staff/{email} {
      allow read: if signedIn() && (email == myEmail() || isStaff());
      allow write: if isStaff();
    }

    match /customers/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.email == myEmail());
      allow write: if isStaff();
    }

    match /listings/{id} {
      allow read: if isStaff() || ownsDoc();
      allow create, delete: if isStaff();
      // Customers may only send their asking price on their own card while it is Awaiting price.
      allow update: if isStaff() || (ownsDoc()
        && resource.data.status == "awaitprice"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["askPrice", "askMin", "askAt"])
        && (request.resource.data.askPrice == null
          ? request.resource.data.get("askMin", null) == null
          : (request.resource.data.askPrice is number
             && request.resource.data.askPrice > 0 && request.resource.data.askPrice < 10000000))
        && (request.resource.data.get("askMin", null) == null
          || (request.resource.data.askMin is number && request.resource.data.askMin > 0
              && request.resource.data.askMin <= request.resource.data.askPrice))
        && request.resource.data.askAt == request.time);
    }

    match /batches/{id} {
      allow read: if isStaff() || ownsDoc();
      allow write: if isStaff();
    }

    match /photos/{id} {
      allow read: if isStaff() || ownsDoc();
      allow write: if isStaff();
    }

    match /batchNotes/{id} {
      allow read, write: if isStaff();
    }

    match /meta/{id} {
      allow read, write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
